{
  "name": "@dalily/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify-mobile-foundation.mjs",
    "verify:customer": "node scripts/verify-customer-app.mjs",
    "verify:provider": "node scripts/verify-provider-app.mjs",
    "verify:native": "node scripts/verify-native-features.mjs",
    "verify:production": "node scripts/verify-production-release.mjs",
    "release:checklist": "node scripts/release-checklist.mjs",
    "eas:build:development": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:production": "eas build --profile production",
    "eas:build:production-apk": "eas build --profile production-apk --platform android",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "eas:submit:android": "eas submit --platform android --profile internal",
    "eas:update:preview": "eas update --channel preview --message",
    "eas:update:production": "eas update --channel production --message",
    "eas:update:rollback": "eas update:rollback --channel production"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.8",
    "expo-camera": "^57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~18.0.13",
    "expo-device": "^57.0.1",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-font": "~14.0.11",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "^57.0.6",
    "expo-image-picker": "^57.0.6",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "^57.0.6",
    "expo-network": "~8.0.8",
    "expo-notifications": "^57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~57.0.10",
    "i18next": "^25.5.2",
    "react": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "^1.29.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
