# Learn more https://docs.expo.dev/guides/using-environment-variables/

EXPO_PUBLIC_APP_ENV=development
APP_ENV=development

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=https://api.dalily.app/v1
EXPO_PUBLIC_APP_URL=https://dalily.app
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_RELEASE_CHANNEL=development
EXPO_PUBLIC_ANALYTICS_KEY=

# Feature flags (true/false)
EXPO_PUBLIC_FF_CUSTOMER_APP=true
EXPO_PUBLIC_FF_PROVIDER_APP=true
EXPO_PUBLIC_FF_OFFLINE_QUEUE=true
EXPO_PUBLIC_FF_BIOMETRIC_PREP=true
EXPO_PUBLIC_FF_SENTRY=false
EXPO_PUBLIC_FF_PUSH_PREP=true
EXPO_PUBLIC_FF_CUSTOMER_AI=true
EXPO_PUBLIC_FF_VOICE_SEARCH_PREP=true
EXPO_PUBLIC_FF_PROVIDER_AI=true
EXPO_PUBLIC_FF_PROVIDER_ASSISTANT=true
EXPO_PUBLIC_FF_NATIVE_FEATURES=true
EXPO_PUBLIC_FF_NATIVE_PUSH=true
EXPO_PUBLIC_FF_NATIVE_CAMERA=true
EXPO_PUBLIC_FF_NATIVE_LOCATION=true
EXPO_PUBLIC_FF_NATIVE_MAPS=true
EXPO_PUBLIC_FF_NATIVE_BIOMETRICS=true
EXPO_PUBLIC_FF_NATIVE_OFFLINE_MEDIA=true
EXPO_PUBLIC_FF_ANALYTICS=false
EXPO_PUBLIC_FF_OTA_UPDATES=false
EXPO_PUBLIC_FF_CONSENT_GATE=true
# WebView bridge to web marketplace flow (request → offers → unlock → chat). Default off.
EXPO_PUBLIC_FF_WEB_REQUEST_FLOW=false

# Observability (Sentry — set in EAS secrets for production)
EXPO_PUBLIC_SENTRY_DSN=

# EAS
EAS_PROJECT_ID=dalily-mobile-foundation
# EAS_OWNER=your-expo-account
