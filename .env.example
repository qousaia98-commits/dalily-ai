# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Optional: overrides for LLM-assisted search problem classification and
# voice transcription (both fall back to OPENAI_API_KEY / gpt-4o-mini).
# SEARCH_LLM_API_KEY=
# SEARCH_LLM_API_URL=
# SEARCH_LLM_MODEL=gpt-4o-mini
# VISION_LLM_MODEL=gpt-4o-mini

# Sprint 9.5 — Vision / Speech engines (canonical; legacy AI_ENGINE_V5/V6 still accepted)
# VISION_ENGINE=true
# SPEECH_ENGINE=true
# OCR_PROVIDER=openai
# WHISPER_PROVIDER=openai

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stabilize Server Action IDs across dev restarts / multi-instance deploys.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Closed beta: set to "false" only for public launch (enables robots indexing)
DALILY_CLOSED_BETA=true

# Payment (manual bank transfer) — REQUIRED for paid plan upgrades in production.
# Leave empty in local/dev to fail closed (upgrade UI blocks instead of showing fake IBAN).
# Dalily 2.0 will reuse this rail for Unlock Fees (Sprint 6) — do not remove keys casually.
PAYMENT_PROVIDER=manual
PAYMENT_RECEIVER=
PAYMENT_ACCOUNT=
PAYMENT_IBAN=
PAYMENT_SWIFT=
PAYMENT_BANK_NAME=

# Optional: Resend confirmation emails after payment approval
# RESEND_API_KEY=
# EMAIL_FROM=Dalily <noreply@dalily.app>

# -----------------------------------------------------------------------------
# Dalily 2.0 feature flags (strangler). Defaults OFF = legacy product behavior.
# Sprint 1: Marketplace domain read-model / projections.
# MARKETPLACE_DOMAIN_V2=true
# Sprint 2: Customer intent intake → publish → waiting room.
# CUSTOMER_INTENT_FLOW_V2=true
# Sprint 3: Matching engine (scarce pools + reason codes). Never uses subscription tier.
# MATCHING_V2=true
# Sprint 4: Competing offers from match assignments + select without contact release.
# OFFERS_V2=true
# Sprint 10 Phase 2: Smart hiring / offer decision engine (requires OFFERS_V2).
# OFFER_DECISION_ENGINE=true
# Sprint 5: Unlock sessions + contact grants (fail closed without payment/bypass).
# UNLOCK_V2=true
# UNLOCK_FEE_AMOUNT=5000
# UNLOCK_FEE_CURRENCY=SYP
# UNLOCK_SLA_HOURS=24
# Dev-only grant without payment event — NEVER enable in production:
# UNLOCK_DEV_BYPASS=true
# Sprint 6: Unlock fee payment capture (manual admin rail + webhook ledger).
# UNLOCK_PAYMENTS_V2=true
# Optional webhook auth (required in production):
# PAYMENT_WEBHOOK_SECRET=
# Local-only insecure webhook when secret unset:
# PAYMENT_WEBHOOK_ALLOW_INSECURE=true
# Optional cron secret for /api/cron/unlock-sla
# CRON_SECRET=
# Sprint 7: Full chat only with contact_release_grants (legacy canChat when off).
# Canonical (Sprint 9.5): CHAT_ENGINE — alias CHAT_AUTH_V2 still accepted.
# CHAT_ENGINE=true
# CHAT_AUTH_V2=true
# MESSAGING_ENGINE=true
# Sprint 10 Phase 3: Enterprise communication (reactions, mute/block/report, timeline, APIs).
# Requires CHAT_ENGINE.
# ENTERPRISE_COMMUNICATION=true
# CHAT_PROVIDER=supabase
# Sprint 8: Unlock-first provider dashboard (legacy success home when off).
# PROVIDER_DASHBOARD_V2=true
# Sprint 9: Admin economy/unlock/trust ops (subscription admin read-only when on).
# ADMIN_MIGRATION_V2=true
# AI Engine Phase 1: knowledge lookup, intent memory, feedback loop (before LLM).
# AI_ENGINE_V1=true
# AI Engine Phase 2: intent pipeline, smart questions, urgency, AI match scores.
# AI_ENGINE_V2=true
# AI Engine Phase 3: smart dispatch, capacity, route fit, ETA, reputation.
# AI_ENGINE_V3=true
# AI Engine Phase 4: job intelligence, tools/materials, duration/price ranges, prep.
# AI_ENGINE_V4=true
# AI Engine Phase 5: Vision Intelligence (image analysis, fusion, prep enrichment).
# Implies V1–V4 when on. Requires SEARCH_LLM_API_KEY / OPENAI_API_KEY.
# AI_ENGINE_V5=true
# AI Engine Phase 6: Voice Intelligence (STT, dialect, multimodal fusion).
# Implies V1–V5 when on. Uses Whisper via OPENAI_API_KEY.
# AI_ENGINE_V6=true
# AI Engine Phase 7: Personal Assistant (lifecycle coach, offer compare, summaries).
# Implies V1–V6 when on.
# AI_ENGINE_V7=true
# AI Engine Phase 8: Predictive Intelligence (demand/availability, balancer, admin AI).
# Implies V1–V7 when on.
# AI_ENGINE_V8=true
# AI Engine Phase 9: Autonomous Actions & Workflow Automation.
# Implies V1–V8 when on. Never auto-runs payments / legal / suspension.
# AI_ENGINE_V9=true
# Sprint 4 Phase 1: Dual Marketplace (publish request vs find provider).
# DUAL_MARKETPLACE=true
# Sprint 4 Phase 2: Smart Booking & AI Scheduling.
# SMART_BOOKING=true
# Sprint 4 Phase 3: Emergency Dispatch & Live Tracking.
# EMERGENCY_DISPATCH=true
# Sprint 4 Phase 4: Multi-Service Projects & AI Project Coordination.
# MULTI_SERVICE_PROJECTS=true
# Sprint 4 Phase 5: Recurring Services & Maintenance Plans.
# RECURRING_SERVICES=true
# Sprint 5 Phase 1: Real-Time Chat enhancements.
# Canonical (Sprint 9.5): REALTIME_ENGINE — aliases REALTIME_CHAT / REALTIME_CHAT_V1 still accepted.
# REALTIME_ENGINE=true
# REALTIME_CHAT=true
# Sprint 5 Phase 2: File Sharing & Media Collaboration.
# FILE_MEDIA_SHARING=true
# MEDIA_MAX_UPLOAD_BYTES=52428800
# MEDIA_MAX_USER_STORAGE_BYTES=2147483648
# Sprint 5 Phase 3: AI Communication Assistant.
# AI_CHAT_ASSISTANT=true
# NEXT_PUBLIC_AI_CHAT_ASSISTANT=true
# CHAT_AI_MODEL=gpt-4o-mini
# Sprint 5 Phase 4: Voice Messages & Smart Voice Assistant (no live calls).
# CHAT_VOICE_MESSAGING=true
# NEXT_PUBLIC_CHAT_VOICE_MESSAGING=true
# Sprint 5 Phase 5: Collaboration Workspace (tasks, checklists, approvals, AI).
# COLLABORATION_WORKSPACE=true
# Sprint 5 Phase 6: Smart Notification Center (priority, grouping, digests).
# SMART_NOTIFICATION_CENTER=true
# Sprint 6 Phase 1: Provider Monetization (FREE / BUSINESS, AI lead pricing).
# PROVIDER_MONETIZATION=true
# Sprint 6 Phase 2: Payment infrastructure (history, snapshots, canonical webhooks).
# Also implied when UNLOCK_PAYMENTS_V2 or PROVIDER_MONETIZATION is on.
# PAYMENT_INFRASTRUCTURE=true
# Sprint 6 Phase 3: Stripe as first real PaymentProvider.
# To enable Stripe, set the active PAYMENT_PROVIDER above to: stripe
# (do not duplicate the key — one canonical value only)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_BUSINESS_PRICE_ID=price_...
# Sprint 6 Phase 4: Automatic invoices & receipts (PDF).
# Also implied when PAYMENT_INFRASTRUCTURE / unlock / monetization flags are on.
# FINANCIAL_DOCUMENTS=true
# Sprint 6 Phase 5: Refunds & disputes (admin approval + Stripe + credit notes).
# Also implied when PAYMENT_INFRASTRUCTURE is on.
# REFUNDS_DISPUTES=true
# Sprint 6 Phase 6: Finance dashboard & revenue analytics (read-only).
# Also implied when PAYMENT_INFRASTRUCTURE is on.
# FINANCE_DASHBOARD=true
# Sprint 10 Phase 4: Enterprise Payment & Wallet Platform.
# PAYMENTS_V2=true
# PAYMENT_WALLET=true
# ESCROW_ENGINE=true
# PAYOUTS_V1=true
# Sprint 7 Phase 2: Ratings, Reviews & AI Reputation (multi-dim, fake detection, reputation cache).
# REVIEWS_REPUTATION_V2=true
# Sprint 7 Phase 3: AI Reputation Engine (modular signals, trust levels, search/recommendation boosts).
# Also implied when REVIEWS_REPUTATION_V2 is on.
# AI_REPUTATION_ENGINE=true

# Sprint 7 Phase 4 — Quality Assurance & Case Management (default off).
# Canonical key (code also accepts QUALITY_CASES_V1 / QA_CASE_MANAGEMENT for backcompat):
# QUALITY_CASES=true

# Sprint 7 Phase 5 — Fraud Detection & Risk Intelligence (admin-only, default off).
# Canonical key (aliases: FRAUD_DETECTION_V1, RISK_INTELLIGENCE):
# FRAUD_DETECTION=true

# Sprint 7 Phase 6 — AI Operations & Platform Health (admin-only, default off).
# Canonical key (aliases: AI_OPS_V1, PLATFORM_HEALTH, AI_OPERATIONS):
# AI_OPS=true

# Sprint 8 Phase 1 — AI Smart Matching Engine (default off).
# Canonical key (aliases deprecated but still accepted: SMART_MATCHING_ENGINE_V1, AI_SMART_MATCHING):
# SMART_MATCHING_ENGINE=true

# Sprint 8 Phase 2 — AI Dynamic Pricing (recommendations only; never forces prices)
# Canonical key (aliases: AI_DYNAMIC_PRICING_V1, DYNAMIC_PRICING):
# AI_DYNAMIC_PRICING=true

# Sprint 8 Phase 3 — AI Demand Forecasting (advisory only; never guarantees outcomes)
# Canonical key (aliases deprecated but still accepted: AI_DEMAND_FORECASTING_V1, DEMAND_FORECASTING):
# Also accepted: FORECAST_ENGINE (Sprint 9.5 canonical)
# AI_DEMAND_FORECASTING=true
# FORECAST_ENGINE=true
# PREDICTIVE_ENGINE=true
# FORECAST_PROVIDER=openai

# Sprint 8 Phase 4 — AI Scheduling & Capacity (advisory; providers decide)
# Canonical key (aliases: AI_SCHEDULING_V1, AI_CAPACITY_OPTIMIZATION):
# AI_SCHEDULING=true

# Sprint 8 Phase 5 — AI Business Assistant (coaching; providers remain in control)
# Canonical key (aliases: AI_BUSINESS_ASSISTANT_V1, BUSINESS_ASSISTANT):
# AI_BUSINESS_ASSISTANT=true

# Sprint 8 Phase 6 — AI Marketplace Intelligence Platform (advisory; sims isolated)
# Canonical key (aliases: AI_MARKETPLACE_INTELLIGENCE_V1, MARKETPLACE_INTELLIGENCE):
# AI_MARKETPLACE_INTELLIGENCE=true

# Sprint 10 Phase 5 — Enterprise AI Platform (provider-independent; recommendations only).
# AI_PLATFORM=true
# AI_ASSISTANT=true
# AI_TRANSLATION=true
# AI_PRICING=true
# AI_ANALYTICS=true
# AI_FRAUD=true
# AI_MODERATION=true
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=mock

# Sprint 9 Phase 1 — Mobile foundation lives in /mobile (.env under mobile/)
# See mobile/.env.example
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Environment validation (Sprint 0+)
# Full checklist: docs/migration/env-checklist.md
# Never commit .env.local or real secrets.
# Sprint 9.5: prefer one canonical flag key per feature in new configs.
